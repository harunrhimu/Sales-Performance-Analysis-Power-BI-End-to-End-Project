/// Measures-only table. Holds the DAX measure library; contains no data.
table _Measures
	lineageTag: 92cf89c0-df37-4b6c-bfe1-f0b389e8161f

	/// Total sales amount across the sales fact.
	measure 'Total Sales' = SUM('Fact Sales'[Sales Amount])
		formatString: #,0.00
		displayFolder: 1. Base Measures
		lineageTag: b9769feb-502b-4824-8067-bff1ba79c7bb

	/// Total cost of goods sold across the sales fact.
	measure 'Total Cost' = SUM('Fact Sales'[Cost Amount])
		formatString: #,0.00
		displayFolder: 1. Base Measures
		lineageTag: 6a0992f9-ec20-4d7e-b893-168c40faf037

	/// Sales less cost.
	measure 'Total Margin' = [Total Sales] - [Total Cost]
		formatString: #,0.00
		displayFolder: 1. Base Measures
		lineageTag: f2285947-4dcf-485a-8286-56f825b64ac1

	/// Gross margin as a share of sales.
	measure 'Margin %' = DIVIDE([Total Margin], [Total Sales])
		formatString: 0.0%
		displayFolder: 1. Base Measures
		lineageTag: 04d9a1e6-a260-4640-902c-058f8cc962c8

	/// Budgeted sales at month x category grain.
	measure 'Budget Sales' = SUM('Fact Budget'[Budget Amount])
		formatString: #,0.00
		displayFolder: 2. Variance
		lineageTag: 518bda92-6aee-4cb9-a348-6fab1c7d4d68

	/// Actual sales less budgeted sales.
	measure 'Sales vs Budget Var' = [Total Sales] - [Budget Sales]
		formatString: #,0.00
		displayFolder: 2. Variance
		lineageTag: 58a5d765-8473-426d-b786-1e6a95735d3c

	/// Actual sales versus budget, as a share of budget.
	measure 'Sales vs Budget Var %' = DIVIDE([Sales vs Budget Var], [Budget Sales])
		formatString: 0.0%
		displayFolder: 2. Variance
		lineageTag: 3a50e801-26e6-4113-914d-1a4e96b87717

	/// Prior-year sales for the equivalent period.
	measure 'Total Sales PY' = CALCULATE([Total Sales], SAMEPERIODLASTYEAR('Dim Date'[Date]))
		formatString: #,0.00
		displayFolder: 2. Variance
		lineageTag: 4af5e536-ae28-4e7b-9a0f-0738c00af2de

	/// Year-on-year sales variance. Drives the KPI card variance badge (positive = favourable).
	measure 'Total Sales PY Var' = [Total Sales] - [Total Sales PY]
		formatString: #,0.00
		displayFolder: 2. Variance
		lineageTag: c39c152e-c7fb-4de1-9950-6b6022298a34

	/// Year-on-year sales variance as a share of prior year.
	measure 'Total Sales PY Var %' = DIVIDE([Total Sales PY Var], [Total Sales PY])
		formatString: 0.0%
		displayFolder: 2. Variance
		lineageTag: 27aa390b-85bd-4b16-8339-7df0cf51f944

	/// Signed text form of the YoY variance, used as the KPI card badge label.
	measure 'Total Sales PY Var % Label' = FORMAT([Total Sales PY Var %], "+0.0%;-0.0%;0.0%")
		displayFolder: 2. Variance
		lineageTag: 1ef1c11b-3ebf-418c-8b67-e2ae50af199f

	/// Sales year-to-date, anchored on the marked Dim Date table.
	measure 'Total Sales YTD' = TOTALYTD([Total Sales], 'Dim Date'[Date])
		formatString: #,0.00
		displayFolder: 3. Time Intelligence
		lineageTag: 4cbfdd90-9d14-4cdc-936d-d4c11aa955ed

	/// Rolling three-month average of MONTHLY sales (not daily). Averages Total Sales across the trailing 3 months. Anchored on the last date that actually has sales, so the card still resolves at grand-total level where the date dimension runs past the data.
	measure 'Rolling 3M Avg Total Sales' =
			VAR Window = DATESINPERIOD ( 'Dim Date'[Date], [Last Sales Date], -3, MONTH )
			VAR MonthCount =
			    COUNTROWS (
			        CALCULATETABLE (
			            SUMMARIZE ( 'Dim Date', 'Dim Date'[Year], 'Dim Date'[Month Number] ),
			            Window
			        )
			    )
			RETURN
			    DIVIDE ( CALCULATE ( [Total Sales], Window ), MonthCount )
		formatString: #,0.00
		displayFolder: 3. Time Intelligence
		lineageTag: b53fd39a-00cb-48c6-a610-1e766299ccdf

	/// Top N cut-off selected in the slicer. Defaults to 10 when nothing is selected.
	measure 'Top N Selected' = SELECTEDVALUE('Top N Selector'[Top N], 10)
		formatString: 0
		displayFolder: 4. Advanced
		lineageTag: 49f300ba-9b75-4760-9058-4b4ac2e716ac

	/// Sales rank per product, respects the current visual filter context. Blank outside product detail rows, where a rank is meaningless.
	measure 'Product Sales Rank' =
			IF (
			    ISINSCOPE ( 'Dim Product'[Product] ),
			    RANKX ( ALLSELECTED ( 'Dim Product'[Product] ), [Total Sales], , DESC, DENSE )
			)
		formatString: 0
		displayFolder: 4. Advanced
		lineageTag: 2c2e42b9-a4aa-41ba-9678-39460ecaf9c6

	/// Dynamic Top N: sales for products inside the selected Top N cut-off. Totals correctly as the sum of the top N products.
	measure 'Top N Sales' =
			VAR N = [Top N Selected]
			VAR TopSales =
			    ADDCOLUMNS (
			        ALLSELECTED ( 'Dim Product'[Product] ),
			        "@sales", [Total Sales]
			    )
			VAR NthSales =
			    MINX ( TOPN ( N, TopSales, [@sales], DESC ), [@sales] )
			RETURN
			    IF (
			        ISINSCOPE ( 'Dim Product'[Product] ),
			        IF ( [Product Sales Rank] <= N, [Total Sales] ),
			        SUMX ( FILTER ( TopSales, [@sales] >= NthSales ), [@sales] )
			    )
		formatString: #,0.00
		displayFolder: 4. Advanced
		lineageTag: 62ad29c7-ecfa-437f-88c4-d014bacae359

	/// IBCS financial account measure. Applies SignModifier so revenue is positive and cost/opex flip negative. CALCULATE is required for context transition.
	measure 'P&L Amount' = SUMX('Dim Financial Accounts', CALCULATE(SUM('Fact Financials'[Amount])) * 'Dim Financial Accounts'[Sign Modifier])
		formatString: #,0.00
		displayFolder: 4. Advanced
		lineageTag: d15e5029-a44c-4c1f-89a0-77d8bf015c0a

	/// Base-scenario forecast at month x category grain. The headline target for variance analysis.
	measure 'Target Sales' = CALCULATE(SUM('Fact Target'[Forecast Amount]), 'Dim Scenario'[Scenario] = "Base")
		formatString: #,0.00
		displayFolder: 2. Variance
		lineageTag: 85757d71-8c6f-40b9-9704-0b9f8e5bb1ed

	/// Actual sales less the Base-scenario target.
	measure 'Sales vs Target Var' = [Total Sales] - [Target Sales]
		formatString: #,0.00
		displayFolder: 2. Variance
		lineageTag: 382dbb27-887e-41f8-8583-601e76a121a4

	/// Actual sales versus target, as a share of target.
	measure 'Sales vs Target Var %' = DIVIDE([Sales vs Target Var], [Target Sales])
		formatString: 0.0%
		displayFolder: 2. Variance
		lineageTag: de9f4bd1-92b5-4c17-ba3c-674f7129aad6

	/// Actual sales as a share of budget. 100% means exactly on plan.
	measure 'Budget Attainment %' = DIVIDE([Total Sales], [Budget Sales])
		formatString: 0.0%
		displayFolder: 2. Variance
		lineageTag: 9d5e93c2-59ab-48cb-84b1-70efbd59ba6f

	/// Month-to-date sales.
	measure 'Total Sales MTD' = TOTALMTD([Total Sales], 'Dim Date'[Date])
		formatString: #,0.00
		displayFolder: 3. Time Intelligence
		lineageTag: 694ee3a3-37f8-4bd4-8a07-581299c08042

	/// Quarter-to-date sales.
	measure 'Total Sales QTD' = TOTALQTD([Total Sales], 'Dim Date'[Date])
		formatString: #,0.00
		displayFolder: 3. Time Intelligence
		lineageTag: 625cc125-1f61-49cc-ad06-fbcc860687e4

	/// Prior-month sales, for month-on-month comparison.
	measure 'Total Sales LM' = CALCULATE([Total Sales], PREVIOUSMONTH('Dim Date'[Date]))
		formatString: #,0.00
		displayFolder: 3. Time Intelligence
		lineageTag: 25b7f49d-762c-4084-989b-1193dbefbda7

	/// Month-on-month sales variance as a share of the prior month.
	measure 'Sales MoM Var %' = DIVIDE([Total Sales] - [Total Sales LM], [Total Sales LM])
		formatString: 0.0%
		displayFolder: 3. Time Intelligence
		lineageTag: aafcf4d2-8ff1-411b-8678-2f54e0f4f036

	/// Trailing twelve-month sales total, anchored on the last date that actually has sales.
	measure 'Rolling 12M Total Sales' =
			CALCULATE (
			    [Total Sales],
			    DATESINPERIOD ( 'Dim Date'[Date], [Last Sales Date], -12, MONTH )
			)
		formatString: #,0.00
		displayFolder: 3. Time Intelligence
		lineageTag: ecfc2727-fa7b-416e-9a3c-187cb7ea286d

	/// Sales over the trailing 30 days from the latest date that actually has sales - a dynamic date range anchored on real data rather than the calendar.
	measure 'Sales Last 30 Days' =
			CALCULATE (
			    [Total Sales],
			    DATESINPERIOD ( 'Dim Date'[Date], [Last Sales Date], -30, DAY )
			)
		formatString: #,0.00
		displayFolder: 3. Time Intelligence
		lineageTag: 24ce8436-8977-41ad-826b-e99af2a1f948

	/// Forecast for every scenario in context. Filter by Dim Scenario to isolate one.
	measure 'Scenario Sales' = SUM('Fact Target'[Forecast Amount])
		formatString: #,0.00
		displayFolder: 4. Scenario
		lineageTag: ad78bd2c-647b-48a2-b79e-857edac4e13b

	/// Optimistic-scenario forecast. The upper bound of the plan.
	measure 'Optimistic Sales' = CALCULATE(SUM('Fact Target'[Forecast Amount]), 'Dim Scenario'[Scenario] = "Optimistic")
		formatString: #,0.00
		displayFolder: 4. Scenario
		lineageTag: a1aaa6e2-22f4-4092-9a5b-6dbaac1e034f

	/// Conservative-scenario forecast. The lower bound of the plan.
	measure 'Conservative Sales' = CALCULATE(SUM('Fact Target'[Forecast Amount]), 'Dim Scenario'[Scenario] = "Conservative")
		formatString: #,0.00
		displayFolder: 4. Scenario
		lineageTag: d7119151-b654-4f2b-939b-e4b27e6528a6

	/// Width of the scenario range - optimistic less conservative.
	measure 'Scenario Spread' = [Optimistic Sales] - [Conservative Sales]
		formatString: #,0.00
		displayFolder: 4. Scenario
		lineageTag: 7ec7f5a1-ef89-4d22-9b99-5963f9c9360b

	/// Actual sales versus the Base forecast, as a share of forecast.
	measure 'Actual vs Forecast Var %' = DIVIDE([Total Sales] - [Target Sales], [Target Sales])
		formatString: 0.0%
		displayFolder: 4. Scenario
		lineageTag: 7f0acffb-9738-40d9-b4b5-2de64f41e874

	/// Units sold across the sales fact.
	measure 'Total Quantity' = SUM('Fact Sales'[Sales Quantity])
		formatString: #,0
		displayFolder: 5. Segmentation
		lineageTag: 88cffeba-1bef-4eed-8672-def63c8dc659

	/// Distinct customers with at least one sale in context.
	measure 'Active Customers' = DISTINCTCOUNT('Fact Sales'[Customer Key])
		formatString: #,0
		displayFolder: 5. Segmentation
		lineageTag: d5670cd4-c337-449f-83ba-828079ce2711

	/// Average revenue per active customer.
	measure 'Sales per Customer' = DIVIDE([Total Sales], [Active Customers])
		formatString: #,0.00
		displayFolder: 5. Segmentation
		lineageTag: 52297fa2-bbaa-4f69-8ea1-570e8bf1a493

	/// Average realised selling price per unit.
	measure 'Avg Selling Price' = DIVIDE([Total Sales], [Total Quantity])
		formatString: #,0.00
		displayFolder: 5. Segmentation
		lineageTag: f180a3a9-96e1-43d3-90f8-9694f8771a8d

	/// This category's share of total sales across all categories.
	measure 'Category Share %' = DIVIDE([Total Sales], CALCULATE([Total Sales], ALLSELECTED('Dim Category')))
		formatString: 0.0%
		displayFolder: 5. Segmentation
		lineageTag: aa1e86b8-88c5-4e9a-8be5-7fab5ef2c1db

	/// This segment's share of total sales across all customer segments.
	measure 'Segment Share %' = DIVIDE([Total Sales], CALCULATE([Total Sales], ALLSELECTED('Dim Customer')))
		formatString: 0.0%
		displayFolder: 5. Segmentation
		lineageTag: db03e56d-b4e2-4bd7-8329-96ea451c8bd3

	/// Sales rank per customer, respecting the current visual filter context. Blank outside customer detail rows.
	measure 'Customer Sales Rank' =
			IF (
			    ISINSCOPE ( 'Dim Customer'[Customer] ),
			    RANKX ( ALLSELECTED ( 'Dim Customer'[Customer] ), [Total Sales], , DESC, DENSE )
			)
		formatString: #,0
		displayFolder: 6. Ranking & Pareto
		lineageTag: a34e8932-515b-4b6a-a5b2-9bf44cedbbcd

	/// This product's share of total product sales.
	measure 'Product Sales % of Total' = DIVIDE([Total Sales], CALCULATE([Total Sales], ALLSELECTED('Dim Product'[Product])))
		formatString: 0.0%
		displayFolder: 6. Ranking & Pareto
		lineageTag: 2e8562db-9220-496d-8007-062162394997

	/// Running total of sales from rank 1 down to the current product - the Pareto curve. Evaluates sales once per product, then compares scalars; totals as the sum of all selected products.
	measure 'Product Cumulative Sales' =
			VAR ProductSales =
			    ADDCOLUMNS (
			        ALLSELECTED ( 'Dim Product'[Product] ),
			        "@sales", [Total Sales]
			    )
			VAR CurrentSales = [Total Sales]
			RETURN
			    IF (
			        ISINSCOPE ( 'Dim Product'[Product] ),
			        SUMX ( FILTER ( ProductSales, [@sales] >= CurrentSales ), [@sales] ),
			        SUMX ( ProductSales, [@sales] )
			    )
		formatString: #,0.00
		displayFolder: 6. Ranking & Pareto
		lineageTag: 45dcf731-2b2f-4429-a35c-5e6cfe6377c1

	/// Cumulative sales as a share of total product sales. Crosses 80% at the Pareto cut-off.
	measure 'Product Cumulative %' = DIVIDE([Product Cumulative Sales], CALCULATE([Total Sales], ALLSELECTED('Dim Product'[Product])))
		formatString: 0.0%
		displayFolder: 6. Ranking & Pareto
		lineageTag: d9ff3efe-13d8-4530-a64b-ac163b23cb1d

	/// Pareto classification: the vital few products that make up the first 80% of sales, versus the useful many. Blank outside product detail rows.
	measure 'Pareto Band' =
			VAR CumulativePct = [Product Cumulative %]
			RETURN
			    IF (
			        ISBLANK ( CumulativePct ) || NOT ISINSCOPE ( 'Dim Product'[Product] ),
			        BLANK (),
			        SWITCH (
			            TRUE (),
			            CumulativePct <= 0.8, "Vital Few (80%)",
			            "Useful Many (20%)"
			        )
			    )
		displayFolder: 6. Ranking & Pareto
		lineageTag: 5801e992-d382-457f-bd92-a356ca1339dc

	/// Sales for products outside the dynamic Top N cut-off - the balance of a Top N vs Others view. Totals as all sales less the Top N total.
	measure 'Top N Others' =
			IF (
			    ISINSCOPE ( 'Dim Product'[Product] ),
			    IF ( [Product Sales Rank] > [Top N Selected], [Total Sales] ),
			    [Total Sales] - [Top N Sales]
			)
		formatString: #,0.00
		displayFolder: 6. Ranking & Pareto
		lineageTag: af022ac2-5381-4b87-a85a-c179a5be8219

	/// How many products it takes to reach 80% of sales. Computes sales once per product and accumulates with scalar math only.
	measure 'Pareto Product Count' =
			VAR Products =
			    ADDCOLUMNS (
			        ALLSELECTED ( 'Dim Product'[Product] ),
			        "@s", [Total Sales]
			    )
			VAR TotalSales = SUMX ( Products, [@s] )
			VAR WithCumulative =
			    ADDCOLUMNS (
			        Products,
			        "@cum",
			        VAR RowSales = [@s]
			        RETURN
			            SUMX ( FILTER ( Products, [@s] >= RowSales ), [@s] )
			    )
			RETURN
			    COUNTROWS (
			        FILTER ( WithCumulative, DIVIDE ( [@cum], TotalSales ) <= 0.8 )
			    )
		formatString: #,0
		displayFolder: 6. Ranking & Pareto
		lineageTag: 32fa4224-90c3-4029-ad4a-4e5f9dbcc5cb

	/// Revenue net of discounts and returns, taken from the P&L structure.
	measure 'Net Revenue' = CALCULATE([P&L Amount], 'Dim Financial Accounts'[Header] = "Revenue")
		formatString: #,0.00
		displayFolder: 7. P&L
		lineageTag: 13cae0e0-d568-489a-938e-60ec0f4c4060

	/// Prior-year P&L amount for the equivalent period.
	measure 'P&L Amount PY' = CALCULATE([P&L Amount], SAMEPERIODLASTYEAR('Dim Date'[Date]))
		formatString: #,0.00
		displayFolder: 7. P&L
		lineageTag: 9767c265-94d1-4541-acf2-1e5f652e2cd8

	/// P&L amount versus prior year.
	measure 'P&L Amount Var' = [P&L Amount] - [P&L Amount PY]
		formatString: #,0.00
		displayFolder: 7. P&L
		lineageTag: 56485688-a1a7-4f95-9c0f-d9ac71e78b6c

	/// P&L variance as a share of prior year. Denominator is absolute because P&L lines carry signs - without ABS every cost variance would flip direction.
	measure 'P&L Amount Var %' = DIVIDE([P&L Amount Var], ABS([P&L Amount PY]))
		formatString: 0.0%
		displayFolder: 7. P&L
		lineageTag: 94bf269f-58e2-43d3-bde6-679e2bc838f8

	/// This P&L line as a share of net revenue - the common-size P&L column.
	measure 'P&L % of Revenue' = DIVIDE([P&L Amount], [Net Revenue])
		formatString: 0.0%
		displayFolder: 7. P&L
		lineageTag: 9adee483-6660-4a31-b60e-0d525e35030d

	/// Average sales per product across the whole portfolio. Uses ALL(Dim Product) rather than ALLSELECTED so the quadrant divider is one global threshold, not a different threshold per category.
	measure 'Avg Sales per Product' = AVERAGEX(ALL('Dim Product'), [Total Sales])
		formatString: #,0.00
		displayFolder: 8. Portfolio
		lineageTag: c0072d43-d5c3-4587-9c22-e13f3daaf5e7

	/// Average product margin rate across the whole portfolio. Uses ALL(Dim Product) so the quadrant divider is a single global threshold.
	measure 'Avg Margin %' = AVERAGEX(ALL('Dim Product'), [Margin %])
		formatString: 0.0%
		displayFolder: 8. Portfolio
		lineageTag: 52f0ac1e-74aa-4816-bbe7-93cc2520f05e

	/// Classifies each product against the average sales and average margin thresholds, producing the four portfolio quadrants.
	measure 'Portfolio Quadrant' =
			VAR AboveSales = [Total Sales] >= [Avg Sales per Product]
			VAR AboveMargin = [Margin %] >= [Avg Margin %]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK([Total Sales]), BLANK(),
			        AboveSales && AboveMargin, "Star",
			        AboveSales, "Volume Player",
			        AboveMargin, "Premium Niche",
			        "Underperformer"
			    )
		displayFolder: 8. Portfolio
		lineageTag: 4b5ceecf-fc20-4dc2-b21a-e70959e6bed8

	/// How close actuals landed to the Base forecast, as a percentage. 100% is a perfect forecast. Blank when no target exists in context.
	measure 'Forecast Accuracy %' =
			VAR VariancePct = DIVIDE ( ABS ( [Total Sales] - [Target Sales] ), [Target Sales] )
			RETURN
			    IF (
			        ISBLANK ( VariancePct ),
			        BLANK (),
			        MAX ( 0, 1 - VariancePct )
			    )
		formatString: 0.0%
		displayFolder: 9. Forecast
		lineageTag: 4b9f7ee3-034d-4eea-be82-72a2d0bd75c8

	/// Trailing three-month average sales annualised - the forward-looking run rate.
	measure 'Annualised Run Rate' = [Rolling 3M Avg Total Sales] * 12
		formatString: #,0.00
		displayFolder: 9. Forecast
		lineageTag: 137c6b60-65e6-4702-93d3-96599f236499

	/// How many standard deviations a day's sales sit from the average day. Blank for days with no sales - an empty day is not an outlier, it is simply empty.
	measure 'Daily Sales Z-Score' =
			VAR CurrentSales = [Total Sales]
			VAR MeanSales = [Avg Daily Sales]
			VAR Days =
			    FILTER ( ALLSELECTED ( 'Dim Date'[Date] ), [Total Sales] <> BLANK () )
			VAR StdDeviation = SQRT ( AVERAGEX ( Days, ( [Total Sales] - MeanSales ) ^ 2 ) )
			VAR ZScore = DIVIDE ( CurrentSales - MeanSales, StdDeviation )
			RETURN
			    IF ( ISBLANK ( CurrentSales ), BLANK (), ZScore )
		formatString: 0.00
		displayFolder: 10. Outliers
		lineageTag: bc90f10e-6977-4764-9d18-6e06791c9999

	/// Flags a day as a high or low outlier when its z-score exceeds two standard deviations.
	measure 'Sales Outlier Flag' =
			VAR ZScore = [Daily Sales Z-Score]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(ZScore), BLANK(),
			        ZScore >= 2, "High Outlier",
			        ZScore <= -2, "Low Outlier",
			        "Normal"
			    )
		displayFolder: 10. Outliers
		lineageTag: 610f365b-6e6e-4bb7-aadc-8aa5413745a3

	/// How far a day's sales sit above or below the average day, as a percentage. Blank when there are no sales.
	measure 'Sales vs Average %' =
			VAR AverageSales = [Avg Daily Sales]
			RETURN
			    IF (
			        ISBLANK ( [Total Sales] ),
			        BLANK (),
			        DIVIDE ( [Total Sales] - AverageSales, AverageSales )
			    )
		formatString: 0.0%
		displayFolder: 10. Outliers
		lineageTag: 0da8084a-5bfa-4caf-a6af-a26a7ca2c3e7

	/// How many standard deviations a month's sales sit from the average month. Blank for months with no sales - an empty month is not an outlier.
	measure 'Monthly Sales Z-Score' =
			VAR CurrentSales = [Total Sales]
			VAR MeanSales = [Avg Monthly Sales]
			VAR Months =
			    FILTER ( ALLSELECTED ( 'Dim Date'[Year Month] ), [Total Sales] <> BLANK () )
			VAR StdDeviation = SQRT ( AVERAGEX ( Months, ( [Total Sales] - MeanSales ) ^ 2 ) )
			VAR ZScore = DIVIDE ( CurrentSales - MeanSales, StdDeviation )
			RETURN
			    IF ( ISBLANK ( CurrentSales ), BLANK (), ZScore )
		formatString: 0.00
		displayFolder: 10. Outliers
		lineageTag: 262ce8c6-3828-4346-95c6-db8f4938dc9d

	/// Flags a month as a high or low outlier when its z-score exceeds two standard deviations. Companion to Sales Outlier Flag, which scores at day grain.
	measure 'Monthly Outlier Flag' =
			VAR ZScore = [Monthly Sales Z-Score]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(ZScore), BLANK(),
			        ZScore >= 2, "High Outlier",
			        ZScore <= -2, "Low Outlier",
			        "Normal"
			    )
		displayFolder: 10. Outliers
		lineageTag: 9b17230b-d080-4fe9-9962-f17b2f5325fb

	/// The average month's sales - the centre line the outlier z-scores are measured against.
	measure 'Avg Monthly Sales' =
			AVERAGEX(
			    FILTER(ALLSELECTED('Dim Date'[Year Month]), [Total Sales] <> BLANK()),
			    [Total Sales]
			)
		formatString: #,0.00
		displayFolder: 10. Outliers
		lineageTag: 4dfb3759-8d2f-4a6a-9b3d-eb2276cc25f1

	/// Prior-year net revenue for the equivalent period.
	measure 'Net Revenue PY' = CALCULATE([Net Revenue], SAMEPERIODLASTYEAR('Dim Date'[Date]))
		formatString: #,0.00
		displayFolder: 2. Variance
		lineageTag: 2b09d1d5-129c-4bb3-91e4-f93393ee15d4

	/// Net revenue versus prior year.
	measure 'Net Revenue PY Var' = [Net Revenue] - [Net Revenue PY]
		formatString: #,0.00
		displayFolder: 2. Variance
		lineageTag: ca6611de-e2f9-4c0d-9d8b-d45db0de4d3c

	/// Net revenue variance versus prior year, as a share of prior year.
	measure 'Net Revenue PY Var %' = DIVIDE([Net Revenue PY Var], [Net Revenue PY])
		formatString: 0.0%
		displayFolder: 2. Variance
		lineageTag: 2747067c-343c-418d-8de2-71ece6b91595

	/// Signed text form of the net revenue YoY variance, used as the KPI card delta chip.
	measure 'Net Revenue PY Var % Label' = FORMAT([Net Revenue PY Var %], "+0.0%;-0.0%;0.0%")
		displayFolder: 2. Variance
		lineageTag: 82eca22f-c76d-45f6-9b67-224cba3eaf2a

	/// Prior-year gross margin for the equivalent period.
	measure 'Total Margin PY' = CALCULATE([Total Margin], SAMEPERIODLASTYEAR('Dim Date'[Date]))
		formatString: #,0.00
		displayFolder: 2. Variance
		lineageTag: 783de99b-2879-48b4-99fa-e571688bc03b

	/// Gross margin versus prior year.
	measure 'Total Margin PY Var' = [Total Margin] - [Total Margin PY]
		formatString: #,0.00
		displayFolder: 2. Variance
		lineageTag: 78b08257-45b1-4b6a-8d95-196ef88c55f1

	/// Gross margin variance versus prior year, as a share of prior year.
	measure 'Total Margin PY Var %' = DIVIDE([Total Margin PY Var], [Total Margin PY])
		formatString: 0.0%
		displayFolder: 2. Variance
		lineageTag: 99abe130-5ead-45cd-9875-f5a5a242b941

	/// Signed text form of the gross margin YoY variance, used as the KPI card delta chip.
	measure 'Total Margin PY Var % Label' = FORMAT([Total Margin PY Var %], "+0.0%;-0.0%;0.0%")
		displayFolder: 2. Variance
		lineageTag: 879e0e6e-1213-475d-9d8a-2cf41944b822

	/// Prior-year gross margin rate, in percentage points for comparison.
	measure 'Margin % PY' = CALCULATE([Margin %], SAMEPERIODLASTYEAR('Dim Date'[Date]))
		formatString: 0.0%
		displayFolder: 2. Variance
		lineageTag: 8e2a0762-1c66-4af8-b3a8-811763700525

	/// Gross margin rate versus prior year, in percentage points.
	measure 'Margin % PY Var' = [Margin %] - [Margin % PY]
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 2. Variance
		lineageTag: 61851514-9564-4214-9645-27a0dce5da9c

	/// Gross margin rate variance versus prior year, as a share of the prior-year rate.
	measure 'Margin % PY Var %' = DIVIDE([Margin % PY Var], [Margin % PY])
		formatString: 0.0%
		displayFolder: 2. Variance
		lineageTag: 651617db-a31d-4f7e-9dd1-7a438e771c65

	/// Signed text form of the margin-rate YoY move, in percentage points, used as the KPI card delta chip.
	measure 'Margin % PY Var % Label' = FORMAT([Margin % PY Var], "+0.0%;-0.0%;0.0%") & " pp"
		displayFolder: 2. Variance
		lineageTag: d98fc35b-a904-4bc2-932d-5bdf9e62a374

	/// Prior-year units sold for the equivalent period.
	measure 'Total Quantity PY' = CALCULATE([Total Quantity], SAMEPERIODLASTYEAR('Dim Date'[Date]))
		formatString: #,0
		displayFolder: 2. Variance
		lineageTag: cdd7eacc-5991-493f-9f12-ed99789c4577

	/// Units sold versus prior year.
	measure 'Total Quantity PY Var' = [Total Quantity] - [Total Quantity PY]
		formatString: #,0
		displayFolder: 2. Variance
		lineageTag: f43a1c2a-6d61-4ba3-9086-e54d7d6d8048

	/// Units sold variance versus prior year, as a share of prior year.
	measure 'Total Quantity PY Var %' = DIVIDE([Total Quantity PY Var], [Total Quantity PY])
		formatString: 0.0%
		displayFolder: 2. Variance
		lineageTag: 945ad880-cf0b-492e-935d-2d5681c32f3c

	/// Signed text form of the units-sold YoY variance, used as the KPI card delta chip.
	measure 'Total Quantity PY Var % Label' = FORMAT([Total Quantity PY Var %], "+0.0%;-0.0%;0.0%")
		displayFolder: 2. Variance
		lineageTag: 00883545-0753-4cb3-a723-394ddf81c6f0

	/// Latest Dim Date with sales in the current filter context. Shared anchor for the rolling and trailing-window measures.
	measure 'Last Sales Date' = CALCULATE ( MAX ( 'Dim Date'[Date] ), 'Fact Sales' )
		formatString: dd-mmm-yyyy
		displayFolder: 3. Time Intelligence
		lineageTag: fda4b600-5687-4984-b954-e4d0460705f9

	/// Average sales across the days that have sales, within the current date selection. Shared by the daily outlier measures.
	measure 'Avg Daily Sales' =
			AVERAGEX (
			    FILTER ( ALLSELECTED ( 'Dim Date'[Date] ), [Total Sales] <> BLANK () ),
			    [Total Sales]
			)
		formatString: #,0.00
		displayFolder: 10. Outliers
		lineageTag: c6368cca-b3bf-4ddb-90ba-2b1913fa3023

