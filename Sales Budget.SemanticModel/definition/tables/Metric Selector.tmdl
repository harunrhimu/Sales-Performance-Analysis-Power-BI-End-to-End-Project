/// Field-parameter table driving the metric slicer: exposes Total Sales, Total Margin, Margin %, Budget Sales, Total Quantity, Active Customers and P&L Amount for dynamic measure switching. Helper - not business data.
table 'Metric Selector'
	lineageTag: 0a19868d-fa1b-4745-ae88-8eabd9d64e00

	column 'Metric Selector Order'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 40a9cef5-466a-4456-9d9a-f5b79e0f8b3d
		summarizeBy: sum
		sourceColumn: [Value3]

	column 'Metric Selector Fields'
		dataType: string
		isHidden
		lineageTag: 008f233e-4de8-4e68-8198-27e42b83dbbc
		summarizeBy: none
		sourceColumn: [Value2]
		sortByColumn: 'Metric Selector Order'

		extendedProperty ParameterMetadata =
				{
				  "version": 3,
				  "kind": 2
				}

	/// Selected metric label from the field parameter; drives dynamic measure switching. Helper - not business data.
	column 'Metric Selector'
		dataType: string
		lineageTag: 04dfbe11-b3a0-4fec-a1e6-d57645cba6e1
		summarizeBy: none
		sourceColumn: [Value1]
		sortByColumn: 'Metric Selector Order'

	partition 'Metric Selector' = calculated
		mode: import
		source =
				{
				    ("Total Sales", NAMEOF('_Measures'[Total Sales]), 0),
				    ("Total Margin", NAMEOF('_Measures'[Total Margin]), 1),
				    ("Margin %", NAMEOF('_Measures'[Margin %]), 2),
				    ("Budget Sales", NAMEOF('_Measures'[Budget Sales]), 3),
				    ("Total Quantity", NAMEOF('_Measures'[Total Quantity]), 4),
				    ("Active Customers", NAMEOF('_Measures'[Active Customers]), 5),
				    ("P&L Amount", NAMEOF('_Measures'[P&L Amount]), 6)
				}

