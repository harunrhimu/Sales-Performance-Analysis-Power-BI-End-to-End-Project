model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["seed_data","pSeedDataFolder","Dim Date","Dim Product","Dim Customer","Dim Financial Accounts","Fact Sales","Fact Budget","Fact Target"]

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table 'Dim Date'
ref table 'Dim Product'
ref table 'Dim Customer'
ref table 'Dim Financial Accounts'
ref table 'Fact Sales'
ref table 'Fact Budget'
ref table 'Fact Target'
ref table 'Dim Category'
ref table 'Dim Scenario'
ref table 'Fact Financials'
ref table _Measures
ref table 'Top N Selector'
ref table 'Metric Selector'
ref table 'Dimension Selector'

ref cultureInfo en-US

